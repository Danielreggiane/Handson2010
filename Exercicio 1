
public class ExercicioVetor {
    public static void main(String[] args) {

        int[] x = {15, 7, 3, 37, 9, 10, 4, 56, 1, 81};

        int y = 2;
        int z = 4;

        System.out.println("a) " + x[y + 1]);
        System.out.println("b) " + x[y * 1]);
        System.out.println("c) " + x[y + z]);
        System.out.println("d) " + x[x[8] * x[6]]);
        System.out.println("e) " + x[y + 2]);
        System.out.println("f) " + x[y * 2]);
        System.out.println("g) " + x[8 - x[6]]);
        System.out.println("h) " + x[x[1]]);
        System.out.println("i) " + x[x[y + z]]);

    }
}
